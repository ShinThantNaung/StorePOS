<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:StorePOS.Infrastructure">

    <!-- 2. Colours. ONE accent: primary button, current sidebar item, selected row, selected toggle. -->
    <SolidColorBrush x:Key="Accent" Color="#2E5E87" />
    <SolidColorBrush x:Key="AccentHover" Color="#244A6B" />
    <SolidColorBrush x:Key="AccentTint" Color="#D5DFE7" />
    <SolidColorBrush x:Key="Text" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#545454" />
    <SolidColorBrush x:Key="Grey500" Color="#767676" />
    <SolidColorBrush x:Key="Grey400" Color="#B3B3B3" />
    <SolidColorBrush x:Key="Grey300" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Grey200" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Grey100" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Grey50" Color="#F7F7F7" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />

    <!-- 3. Type. WPF falls back per character: Latin and digits in Segoe UI, Burmese in Myanmar Text. -->
    <FontFamily x:Key="AppFont">Segoe UI, Myanmar Text</FontFamily>

    <ui:BoolToVisibleConverter x:Key="BoolToVisible" />
    <ui:BoolToVisibleConverter x:Key="BoolToCollapsed" Invert="True" />
    <ui:EqualsConverter x:Key="Eq" />
    <ui:BoolToSemiBoldConverter x:Key="BoolToSemiBold" />
    <ui:BoolToStrikeConverter x:Key="BoolToStrike" />
    <ui:BoolToSecondaryBrushConverter x:Key="BoolToSecondary" />
    <ui:BarWidthConverter x:Key="BarWidth" />

    <!-- Keyboard focus: 2 outline in Text colour, 1 away from the control. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource Text}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Grey100}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <!-- With the Burmese UI language WPF would draw 250 as ၂၅၀, even inside product names.
             Digits stay Latin (Segoe UI), as the design specifies. -->
        <Setter Property="NumberSubstitution.Substitution" Value="European" />
        <Setter Property="NumberSubstitution.CultureSource" Value="Text" />
    </Style>

    <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource AppWindow}">
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="Height" />
    </Style>

    <!-- Text styles -->
    <Style x:Key="Total36" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Figure28" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="H24" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H20" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H18" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="27" />
    </Style>
    <Style x:Key="Paragraph" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="27" />
    </Style>
    <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Paragraph}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- White 1 px panel -->
    <Style x:Key="WhitePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- "VOIDED" tag: 1 px TextSecondary border, radius 2, semibold, padding 0 6 -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- "OUT" tag on the Stock screen: like the VOIDED tag, but in the main text colour. -->
    <Style x:Key="OutTag" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="BorderBrush" Value="{StaticResource Text}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- 5. Default button: Grey200 fill, Grey500 border. Hover Grey300. -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="{StaticResource Grey200}" />
        <Setter Property="BorderBrush" Value="{StaticResource Grey500}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{StaticResource Grey300}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding ui:Ui.CornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding (ui:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding (ui:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey100}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Grey400}" />
                            <Setter Property="Foreground" Value="{StaticResource Grey500}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button: Accent fill, white text. Only ONE per screen or dialog. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="ui:Ui.HoverBackground" Value="{StaticResource AccentHover}" />
    </Style>

    <!-- Large action button: 48 tall, font 18 (Save sale, Record repayment) -->
    <Style x:Key="LargePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- Button inside a table row: 36 tall -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Icon-only button: 44 x 44, needs AutomationProperties.Name -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Flat chevron button used to expand a sale row -->
    <Style x:Key="ExpandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Geometry x:Key="ChevronLeft">M10,3 L5,8 L10,13</Geometry>
    <Geometry x:Key="ChevronRight">M6,3 L11,8 L6,13</Geometry>
    <Geometry x:Key="ChevronDown">M3,6 L8,11 L13,6</Geometry>
    <Geometry x:Key="ChevronUp">M3,10 L8,5 L13,10</Geometry>
    <Geometry x:Key="CalendarIcon">M2.5,3.5 H13.5 V13.5 H2.5 Z M2.5,6.5 H13.5 M5,1.5 V4.5 M11,1.5 V4.5</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- Toggle group button (category filter, Show filter, Daily/Weekly). Selected = Accent fill. -->
    <Style x:Key="ToggleFilterButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="{StaticResource Grey200}" />
        <Setter Property="BorderBrush" Value="{StaticResource Grey500}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding ui:Ui.CornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey300}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource White}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar item: 56 tall, 18 semibold, text inset 20. Current item Accent fill. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="56" />
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter Margin="20,0,12,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey300}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource White}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text box: white, 1 px Grey500, radius 2, padding 0 10. Placeholder Grey500. -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource Grey500}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Ph" Text="{TemplateBinding ui:Ui.Placeholder}" Foreground="{StaticResource Grey500}"
                                       Margin="2,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextAlignment="{TemplateBinding TextAlignment}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey100}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Grey400}" />
                            <Setter Property="Foreground" Value="{StaticResource Grey500}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Money and quantity boxes are right-aligned. -->
    <Style x:Key="MoneyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="BigMoneyTextBox" TargetType="TextBox" BasedOn="{StaticResource MoneyTextBox}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Number box inside a table row: 36 tall -->
    <Style x:Key="CellTextBox" TargetType="TextBox" BasedOn="{StaticResource MoneyTextBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- Dropdown -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey300}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="B" Background="{StaticResource White}" BorderBrush="{StaticResource Grey500}"
                                            BorderThickness="1" CornerRadius="2">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="16" Height="16"
                                              Data="{StaticResource ChevronDown}" Stroke="{StaticResource Text}" StrokeThickness="1.8" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selection" IsHitTestVisible="False" Margin="10,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- IsEditable: type a new value or pick an earlier one (the stock-in supplier). -->
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Margin="1,1,40,1" Padding="7,0,0,0"
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="False" PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource White}" BorderBrush="{StaticResource Grey500}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box: 24 box, 44 tall row -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="24" Height="24" Background="{StaticResource White}" BorderBrush="{StaticResource Grey500}"
                                BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M4,11 L9,16 L18,5" Stroke="{StaticResource Text}" StrokeThickness="2.5" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tables: white, 1 px Grey400 outline, header Grey200, rows White / Grey50, selected AccentTint, row line Grey200 -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="RowBackground" Value="{StaticResource White}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Grey50}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Grey200}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="MinRowHeight" Value="40" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <!-- Same parts as the stock template, plus a grey header corner above the scrollbar. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" />
                                        <Border Grid.Column="1" Background="{StaticResource Grey200}"
                                                BorderBrush="{StaticResource Grey400}" BorderThickness="0,0,0,1" />
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical"
                                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Orientation="Horizontal"
                                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Grey200}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Header text wraps rather than being cut, so longer Burmese labels still fit. -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                               TextAlignment="{Binding (TextBlock.TextAlignment), RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Text" Value="▲" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Text" Value="▼" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="CanUserSort" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey300}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NumHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="TextBlock.TextAlignment" Value="Right" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Cells holding text boxes or buttons: keep Tab moving between the inputs, not the cells. -->
    <Style x:Key="InputCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- Text columns wrap; number columns do not. Never an ellipsis. -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CellNum" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CellNumBold" TargetType="TextBlock" BasedOn="{StaticResource CellNum}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Margin" Value="16,64,16,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</ResourceDictionary>
