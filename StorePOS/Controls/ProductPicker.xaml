<UserControl x:Class="StorePOS.Controls.ProductPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:StorePOS.Infrastructure"
             x:Name="Self">
    <UserControl.Resources>
        <!-- Items never take focus, so typing continues in the box while the list is open. -->
        <Style x:Key="PickerItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Grey300}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="Box" l:Ui.Placeholder="{l:Tr Search_ProductPlaceholder}"
                 AutomationProperties.Name="{Binding Label, ElementName=Self}"
                 TextChanged="Box_TextChanged" PreviewKeyDown="Box_PreviewKeyDown" LostKeyboardFocus="Box_LostKeyboardFocus" />
        <Popup x:Name="MatchPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="True"
               Focusable="False" AllowsTransparency="False" PopupAnimation="None">
            <Border Background="{StaticResource White}" BorderBrush="{StaticResource Grey500}" BorderThickness="1"
                    Width="{Binding ActualWidth, ElementName=Box}">
                <Grid>
                    <ListBox x:Name="MatchList" MaxHeight="320" BorderThickness="0" Background="Transparent" Focusable="False"
                             ItemContainerStyle="{StaticResource PickerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding NameAndSize}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Company}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                               Visibility="{Binding Company, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoMatch" Margin="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                               Text="{l:Tr Picker_NoMatch}" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
