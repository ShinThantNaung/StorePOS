<Window x:Class="StorePOS.Dialogs.RecordStockInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        xmlns:c="clr-namespace:StorePOS.Controls"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="960" Height="640" SizeToContent="Manual">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource H24}" Text="{l:Tr Stock_RecordIn}" />

        <!-- Date and supplier, then an optional note -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr Col_Date}" TextWrapping="Wrap" />
            <c:DateBox Grid.Column="2" BoxWidth="248" SelectedDate="{Binding Date}" DisplayText="{Binding DateText}"
                       MaxDate="{Binding Today}" Label="{l:Tr Col_Date}" />
            <TextBlock Grid.Column="4" Style="{StaticResource Label}" Text="{l:Tr StockIn_From}" TextWrapping="Wrap" />
            <ComboBox Grid.Column="6" IsEditable="True" ItemsSource="{Binding Suppliers}"
                      Text="{Binding SupplierText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr StockIn_From}" />

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{l:Tr StockIn_Note}" TextWrapping="Wrap" />
            <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                     l:Ui.Placeholder="{l:Tr StockIn_NotePlaceholder}" AutomationProperties.Name="{l:Tr StockIn_Note}" />
        </Grid>

        <!-- Find a product, type how many came in, Add -->
        <Border Grid.Row="4" Style="{StaticResource WhitePanel}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Col_Product}" />
                <c:ProductPicker x:Name="Picker" Grid.Column="2" Products="{Binding Products}"
                                 SelectedProduct="{Binding PickedProduct}" Label="{l:Tr Col_Product}" Picked="Picker_Picked" />
                <TextBlock Grid.Column="4" Style="{StaticResource Label}" Text="{l:Tr Sales_Quantity}" />
                <TextBox x:Name="QtyBox" Grid.Column="6" Style="{StaticResource MoneyTextBox}"
                         Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr Sales_Quantity}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="8" Content="{l:Tr StockIn_Add}" Command="{Binding AddCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="7" Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="{l:Tr StockIn_Hint}" />
            </Grid>
        </Border>

        <!-- The delivery so far; Adding can still be changed in the row -->
        <Grid Grid.Row="6">
            <DataGrid ItemsSource="{Binding Lines}" MinRowHeight="52" CellStyle="{StaticResource InputCell}"
                      KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="{l:Tr Stock_RecordIn}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Col_Product}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_Unit}" Binding="{Binding Unit}" Width="84" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_InStockNow}" Binding="{Binding NowText}" Width="120"
                                        ElementStyle="{StaticResource CellNum}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:Tr Col_Adding}" Width="132" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource CellTextBox}" Margin="10,0" FontWeight="SemiBold"
                                         Text="{Binding AddingText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{Binding AddingLabel}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr Col_After}" Binding="{Binding AfterText}" Width="100"
                                        ElementStyle="{StaticResource CellNumBold}" HeaderStyle="{StaticResource NumHeader}" />
                    <!-- Wide enough that "Remove" is never clipped (Burmese checklist: no truncation). -->
                    <DataGridTemplateColumn Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallButton}" MinWidth="0" Padding="6,0" Margin="8,0"
                                        Content="{l:Tr Sales_Remove}" AutomationProperties.Name="{Binding RemoveLabel}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr StockIn_Empty}"
                       Visibility="{Binding Lines.Count, Converter={StaticResource BoolToCollapsed}}" />
        </Grid>

        <TextBlock Grid.Row="7" Style="{StaticResource Warning}" Margin="0,8,0,0" Text="{Binding Problem}"
                   Visibility="{Binding Problem, Converter={StaticResource BoolToVisible}}" />

        <DockPanel Grid.Row="9">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                <Button Content="{l:Tr Dialog_Cancel}" IsCancel="True" />
                <!-- Not the default button: Enter adds a product, it must never save the delivery by accident. -->
                <Button Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="8,0,0,0"
                        Content="{l:Tr StockIn_Save}" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding FooterText}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
