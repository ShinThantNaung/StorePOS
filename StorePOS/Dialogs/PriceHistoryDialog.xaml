<Window x:Class="StorePOS.Dialogs.PriceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="720" Height="620" SizeToContent="Manual">
    <!-- Design 7.3b is 640 x 580 inside. 620 tall because the window frame takes about 40; 720 wide so
         Burmese "How it changed" text fits in two lines and about four changes show at once. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H24}" Text="{l:Tr Prices_History}" />
            <TextBlock Style="{StaticResource H20}" Text="{Binding ProductName}" />
            <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding SubtitleText}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource WhitePanel}" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,6" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           Text="{Binding SinceText}" />
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="{l:Tr PriceHistory_Now}" />
                    <TextBlock Style="{StaticResource Figure28}" Text="{Binding PriceNowText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
            <DataGrid ItemsSource="{Binding Rows}" AutomationProperties.Name="{l:Tr Prices_History}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="DateColumn" Header="{l:Tr Col_Date}" Binding="{Binding DateText}" Width="176"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_PriceKs}" Binding="{Binding PriceText}" Width="104"
                                        ElementStyle="{StaticResource CellNumBold}" HeaderStyle="{StaticResource NumHeader}" />
                    <!-- Auto, not a fixed 104: "First price" in Burmese is wider, and a header must not break inside a word. -->
                    <DataGridTextColumn Header="{l:Tr Col_Change}" Binding="{Binding ChangeText}" Width="Auto" MinWidth="104"
                                        ElementStyle="{StaticResource CellNum}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTextColumn Header="{l:Tr Col_HowChanged}" Binding="{Binding HowText}" Width="*"
                                        ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr PriceHistory_Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
        </Grid>

        <TextBlock Grid.Row="6" Style="{StaticResource Hint}" Text="{l:Tr PriceHistory_Note}" />

        <Button Grid.Row="8" HorizontalAlignment="Right" MinWidth="120" Content="{l:Tr Dialog_Close}"
                IsCancel="True" IsDefault="True" />
    </Grid>
</Window>
