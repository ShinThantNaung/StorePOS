<Window x:Class="StorePOS.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="600">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H24}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr Product_Name}" />
            <TextBox x:Name="NameBox" Grid.Column="2" AutomationProperties.Name="{l:Tr Product_Name}" />

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{l:Tr Product_Category}" />
            <ComboBox x:Name="CategoryBox" Grid.Row="2" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="{l:Tr Product_Category}" />

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{l:Tr Product_Unit}" />
            <TextBox x:Name="UnitBox" Grid.Row="4" Grid.Column="2" l:Ui.Placeholder="{l:Tr Product_UnitPlaceholder}"
                     AutomationProperties.Name="{l:Tr Product_Unit}" />

            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{l:Tr Product_Price}" />
            <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal">
                <TextBox x:Name="PriceBox" Style="{StaticResource MoneyTextBox}" Width="180" AutomationProperties.Name="{l:Tr Product_Price}" />
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Ks}" Margin="8,0,0,0" />
            </StackPanel>

            <CheckBox x:Name="WeightBox" Grid.Row="8" Grid.Column="2" AutomationProperties.Name="{l:Tr Product_SoldByWeight}">
                <TextBlock Text="{l:Tr Product_SoldByWeight}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="ActiveBox" Grid.Row="9" Grid.Column="2" AutomationProperties.Name="{l:Tr Product_Active}">
                <TextBlock Text="{l:Tr Product_Active}" TextWrapping="Wrap" />
            </CheckBox>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Style="{StaticResource Warning}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr Dialog_Cancel}" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="8,0,0,0" IsDefault="True"
                    Content="{l:Tr Product_Save}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
