<Window x:Class="StorePOS.Dialogs.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="520">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H24}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr Customer_Name}" />
            <TextBox x:Name="NameBox" Grid.Column="2" AutomationProperties.Name="{l:Tr Customer_Name}" />
            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{l:Tr Customer_Address}" />
            <TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="2" l:Ui.Placeholder="{l:Tr Customer_AddressPlaceholder}"
                     AutomationProperties.Name="{l:Tr Customer_Address}" />
            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{l:Tr Customer_Phone}" />
            <TextBox x:Name="PhoneBox" Grid.Row="4" Grid.Column="2" l:Ui.Placeholder="{l:Tr Customer_PhoneOptional}"
                     AutomationProperties.Name="{l:Tr Customer_Phone}" />
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Style="{StaticResource Warning}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr Dialog_Cancel}" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="8,0,0,0" IsDefault="True"
                    Content="{l:Tr Customer_Save}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
