<Window x:Class="StorePOS.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="520">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H24}" />
        <TextBox x:Name="MessageText" Grid.Row="2" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                 Height="Auto" TextWrapping="Wrap" FocusVisualStyle="{x:Null}" />
        <Button x:Name="CloseButton" Grid.Row="4" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                Content="{l:Tr Dialog_Close}" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
