<Window x:Class="StorePOS.Dialogs.RepaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        xmlns:c="clr-namespace:StorePOS.Controls"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="520" MinHeight="420">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource H24}" Text="{l:Tr Repay_Title}" />
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="{Binding CustomerLine}" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr Repay_StillOwes}" />
            <TextBlock Grid.Column="1" Style="{StaticResource H20}" Text="{Binding BalanceText}" />

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{l:Tr Repay_Date}" />
            <c:DateBox Grid.Row="2" Grid.Column="1" BoxWidth="220" SelectedDate="{Binding Date}" DisplayText="{Binding DateText}"
                       MaxDate="{Binding Today}" Label="{l:Tr Repay_Date}" />

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{l:Tr Repay_Amount}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="AmountBox" Style="{StaticResource BigMoneyTextBox}" Width="180"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr Repay_Amount}" />
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Ks}" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{l:Tr Repay_After}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Paragraph}" Text="{Binding AfterText}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="5" Style="{StaticResource Warning}" Text="{Binding Problem}" />
        <TextBlock Grid.Row="7" Style="{StaticResource Hint}" Text="{l:Tr Repay_Note}" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr Dialog_Cancel}" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="8,0,0,0" IsDefault="True"
                    Content="{l:Tr Repay_Save}" IsEnabled="{Binding CanSave}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
