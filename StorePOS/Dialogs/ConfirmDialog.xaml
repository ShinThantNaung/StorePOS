<Window x:Class="StorePOS.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:StorePOS.Infrastructure"
        Style="{StaticResource DialogWindow}" Title="{l:Tr App_Title}" Width="480" MinHeight="220">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H24}" />
        <TextBlock x:Name="MessageText" Grid.Row="2" Style="{StaticResource Paragraph}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="KeepButton" IsCancel="True" />
            <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Action_Click" />
        </StackPanel>
    </Grid>
</Window>
