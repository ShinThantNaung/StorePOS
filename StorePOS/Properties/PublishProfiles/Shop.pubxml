<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained StorePOS.exe for the shop laptop: no .NET runtime or other software to install.
  dotnet publish StorePOS/StorePOS.csproj -p:PublishProfile=Shop
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLite and the PDF engine are native DLLs; pack them into the one exe too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\publish\</PublishDir>
  </PropertyGroup>
</Project>
