<UserControl x:Class="StorePOS.Views.StockInsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:StorePOS.Infrastructure">
    <UserControl.Resources>
        <!-- Cells of the small table inside an opened delivery -->
        <Style x:Key="SubHeadCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LargePrimaryButton}" VerticalAlignment="Center"
                    Content="{l:Tr Stock_RecordIn}" Command="{Binding RecordInCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource ToggleFilterButton}" MinWidth="150" l:Ui.CornerRadius="2,0,0,2"
                             Content="{l:Tr Stock_Current}" Command="{Binding ShowCurrentCommand}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" MinWidth="150" l:Ui.CornerRadius="0,2,2,0" Margin="-1,0,0,0"
                             Content="{l:Tr Stock_InHistory}" IsChecked="True" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Search}" Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox" Width="360" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         l:Ui.Placeholder="{l:Tr StockIns_SearchPlaceholder}" AutomationProperties.Name="{l:Tr Search}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="4">
            <!-- Details are always "visible" to the grid; the template itself collapses unless the row is opened. -->
            <DataGrid x:Name="Table" ItemsSource="{Binding View}" CellStyle="{StaticResource InputCell}"
                      RowDetailsVisibilityMode="Visible" AutomationProperties.Name="{l:Tr Stock_InHistory}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentTint}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="DateColumn" Header="{l:Tr Col_Date}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:Tr Col_From}" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FromText}" TextWrapping="Wrap"
                                               Foreground="{Binding IsNotGiven, Converter={StaticResource BoolToSecondary}}" />
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                               Visibility="{Binding Note, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:Tr Col_ProductsReceived}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CellText}" VerticalAlignment="Top" Text="{Binding SummaryText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ExpandButton}" VerticalAlignment="Top" Margin="0,4,0,0"
                                        Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding ToggleLabel}">
                                    <Path x:Name="Chevron" Style="{StaticResource Icon}" Data="{StaticResource ChevronDown}" />
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Chevron" Property="Data" Value="{StaticResource ChevronUp}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <!-- Sits under the Products received column: 170 + 260 + 10 from the left, 56 + 10 from the right. -->
                        <Border Style="{StaticResource WhitePanel}" Margin="440,0,66,14"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <Grid MinHeight="36" Background="{StaticResource Grey200}" TextElement.FontWeight="SemiBold">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource Grey400}" BorderThickness="0,0,0,1" />
                                    <TextBlock Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:Tr Col_Product}" />
                                    <Border Grid.Column="1" Style="{StaticResource SubHeadCell}">
                                        <TextBlock VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Text="{l:Tr Col_Added}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SubHeadCell}">
                                        <TextBlock VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Text="{l:Tr Col_Before}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource SubHeadCell}">
                                        <TextBlock VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Text="{l:Tr Col_After}" />
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Grey200}" BorderThickness="0,0,0,1" MinHeight="36">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="10,6" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource CellNumBold}" Text="{Binding AddedText}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource CellNum}" Text="{Binding BeforeText}" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource CellNum}" Text="{Binding AfterText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
            <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </Grid>
</UserControl>
