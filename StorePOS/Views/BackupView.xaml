<UserControl x:Class="StorePOS.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:StorePOS.Infrastructure">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="900" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource H20}" Text="{l:Tr Backup_Title}" />

        <Border Grid.Row="2" Style="{StaticResource WhitePanel}" Padding="16">
            <StackPanel>
                <TextBlock Text="{l:Tr Backup_Folder}" FontWeight="SemiBold" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Tr Backup_ChooseFolder}" Command="{Binding ChooseFolderCommand}" />
                    <TextBox IsReadOnly="True" Text="{Binding FolderText, Mode=OneWay}" AutomationProperties.Name="{l:Tr Backup_Folder}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{l:Tr Backup_FolderHint}" />
                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="180"
                            Content="{l:Tr Backup_Now}" Command="{Binding BackupNowCommand}" />
                    <TextBlock Text="{Binding LastBackupText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0" Text="{Binding Status}" Style="{StaticResource Paragraph}"
                           FontWeight="{Binding StatusIsProblem, Converter={StaticResource BoolToSemiBold}}"
                           Visibility="{Binding Status, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Content="{l:Tr Restore_FromFile}" Command="{Binding RestoreFromFileCommand}" />
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource H20}" Text="{l:Tr Restore_Title}" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Restore_Hint}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="6">
            <DataGrid ItemsSource="{Binding Copies}" CellStyle="{StaticResource InputCell}" MinRowHeight="48"
                      AutomationProperties.Name="{l:Tr Restore_Title}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Col_Copy}" Binding="{Binding DateText}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_Size}" Binding="{Binding SizeText}" Width="120"
                                        ElementStyle="{StaticResource CellNum}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Width="Auto" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallButton}" Margin="10,0" Content="{l:Tr Restore_This}"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr Restore_None}"
                       Visibility="{Binding NoCopies, Converter={StaticResource BoolToVisible}}" />
        </Grid>

        <!-- Language -->
        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource WhitePanel}" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{l:Tr Language_Title}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource ToggleFilterButton}" Content="မြန်မာ" xml:lang="my-MM"
                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=my}" />
                    <RadioButton Style="{StaticResource ToggleFilterButton}" Content="English" xml:lang="en-GB" Margin="8,0,0,0"
                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=en}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Warning}" Margin="0,8,0,0" Text="{l:Tr Language_Restart}"
                           Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
