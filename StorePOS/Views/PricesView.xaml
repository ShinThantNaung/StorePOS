<UserControl x:Class="StorePOS.Views.PricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:StorePOS.Infrastructure">
    <Grid Margin="16" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Three toolbar rows share one label column, so the boxes line up. -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Tr Prices_Add}" Command="{Binding AddCommand}" />
                <Button Content="{l:Tr Prices_Edit}" Command="{Binding EditCommand}" Margin="8,0,0,0" />
                <Button Content="{l:Tr Prices_History}" Command="{Binding HistoryCommand}" Margin="8,0,0,0" />
                <Button Content="{l:Tr Prices_Import}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolbarLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Search}" Margin="0,0,12,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Width="360" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         l:Ui.Placeholder="{l:Tr Search_ProductPlaceholder}" AutomationProperties.Name="{l:Tr Search}" />
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolbarLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Filter_Company}" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="360" Text="{Binding CompanyText, UpdateSourceTrigger=PropertyChanged}"
                             l:Ui.Placeholder="{l:Tr Search_CompanyPlaceholder}" AutomationProperties.Name="{l:Tr Filter_Company}" />
                    <TextBlock Style="{StaticResource Label}" Text="{l:Tr Filter_Size}" Margin="24,0,8,0" />
                    <ComboBox Width="160" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}"
                              DisplayMemberPath="Display" AutomationProperties.Name="{l:Tr Filter_Size}" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ToolbarLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr Prices_Category}" Margin="0,0,12,0" Height="44" Padding="0,10,0,0"
                       VerticalAlignment="Top" />
            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Cat_All}" Margin="0,0,8,0"
                             IsChecked="{Binding Category, Converter={StaticResource Eq}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Cat_Pesticide}" Margin="0,0,8,0"
                             IsChecked="{Binding Category, Converter={StaticResource Eq}, ConverterParameter=Pesticide}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Cat_Herbicide}" Margin="0,0,8,0"
                             IsChecked="{Binding Category, Converter={StaticResource Eq}, ConverterParameter=Herbicide}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Cat_Fertilizer}" Margin="0,0,8,0"
                             IsChecked="{Binding Category, Converter={StaticResource Eq}, ConverterParameter=Fertilizer}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Cat_Seed}" Margin="0,0,8,0"
                             IsChecked="{Binding Category, Converter={StaticResource Eq}, ConverterParameter=Seed}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Cat_Other}" Margin="0,0,8,0"
                             IsChecked="{Binding Category, Converter={StaticResource Eq}, ConverterParameter=Other}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="6">
            <DataGrid x:Name="Table" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      CanUserSortColumns="True" Sorting="Grid_Sorting" MouseDoubleClick="Grid_MouseDoubleClick"
                      AutomationProperties.Name="{l:Tr Nav_Prices}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:Tr Col_Name}" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                               Foreground="{Binding Inactive, Converter={StaticResource BoolToSecondary}}" />
                                    <Border Style="{StaticResource Tag}" Margin="0,2,0,0"
                                            Visibility="{Binding Inactive, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="{l:Tr Prices_NotSold}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr Col_Company}" Binding="{Binding Company}" Width="160"
                                        SortMemberPath="CompanySortKey" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_ProductSize}" Binding="{Binding Size}" Width="120" CanUserSort="False"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_Category}" Binding="{Binding CategoryName}" Width="140"
                                        SortMemberPath="CategorySortKey" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_Unit}" Binding="{Binding UnitDisplay}" Width="160" CanUserSort="False"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_PriceKs}" Binding="{Binding PriceText}" Width="120" SortMemberPath="Price"
                                        ElementStyle="{StaticResource CellNum}" HeaderStyle="{StaticResource NumHeader}" />
                    <!-- PR1: the date the price last changed. Auto so the Burmese header never breaks inside a word. -->
                    <DataGridTextColumn Header="{l:Tr Col_PriceChanged}" Binding="{Binding PriceChangedText}" Width="Auto" MinWidth="140"
                                        SortMemberPath="PriceChangedAt" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr Prices_Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </Grid>
</UserControl>
