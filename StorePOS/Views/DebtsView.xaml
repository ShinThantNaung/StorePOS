<UserControl x:Class="StorePOS.Views.DebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:StorePOS.Infrastructure">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource WhitePanel}" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{l:Tr Debts_TotalOwed}" />
                    <TextBlock Style="{StaticResource Figure28}" Text="{Binding TotalOwedText}" />
                </StackPanel>
                <StackPanel Margin="64,0,0,0">
                    <TextBlock Style="{StaticResource Secondary}" Text="{l:Tr Debts_StillOweCount}" />
                    <TextBlock Style="{StaticResource Figure28}" Text="{Binding OwingCountText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Search}" Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox" Width="360" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         l:Ui.Placeholder="{l:Tr Search_CustomerPlaceholder}" AutomationProperties.Name="{l:Tr Search}" />
                <TextBlock Style="{StaticResource Label}" Text="{l:Tr Debts_Show}" Margin="24,0,12,0" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Debts_StillOwes}"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Owes}" />
                <RadioButton Style="{StaticResource ToggleFilterButton}" Content="{l:Tr Debts_PaidInFull}" Margin="8,0,0,0"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Paid}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="4">
            <DataGrid x:Name="Table" ItemsSource="{Binding View}" MinRowHeight="48" CellStyle="{StaticResource InputCell}"
                      AutomationProperties.Name="{l:Tr Nav_Debts}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Col_Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_Address}" Binding="{Binding Address}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:Tr Col_StillOwesKs}" Binding="{Binding BalanceText}" Width="200" SortMemberPath="Balance"
                                        ElementStyle="{StaticResource CellNumBold}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallButton}" Margin="10,0" MinWidth="0" Content="{l:Tr Debts_Open}"
                                        AutomationProperties.Name="{Binding OpenLabel}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr Debts_Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </Grid>
</UserControl>
